
# ==========================================
# TERRAFORM
# ==========================================

# Terraform working directories
.terraform/
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Saved Terraform plans
*.tfplan

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive Terraform CLI configuration
.terraformrc
terraform.rc


# ==========================================
# PYTHON
# ==========================================

# Python virtual environments
.venv/
**/.venv/
venv/
**/venv/

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Generated Python Lambda dependencies
**/lambda/package/

# Generated Lambda deployment packages
**/function.zip


# ==========================================
# MACOS
# ==========================================

.DS_Store
.AppleDouble
.LSOverride

# Keep Day 19 Lambda deployment ZIP
!day-19-image-processing-lambda/lambda/function.zip